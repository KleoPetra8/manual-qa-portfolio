							"});\r",
							"pm.test(\"Response contains user ID\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    pm.expect(jsonData).to.have.property(\"id\");\r",
							"});\r",
							"pm.test(\"User name is correct\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.name).to.eql(\"Petra Test\");\r",
							"});\r",
							"\r",
							"pm.test(\"User email is correct\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.email).to.eql(\"petra.test@example.com\");\r",
							"});"
